  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<div class=\"withholding-voucher-print-format\">\n    <header>\n        <div class=\"header-left\">\n            <h2 class=\"company-name\">{{ doc.empresa }}</h2>\n            <p>{{ doc.company_address }}</p>\n            <p>RIF: {{ doc.company_rif }}</p>\n        </div>\n        <div class=\"header-right\">\n            <h1>Comprobante de Retención de IVA</h1>\n            <p>No. de Comprobante: **{{ doc.voucher_number }}**</p>\n        </div>\n    </header>\n\n    <div class=\"details\">\n        <div class=\"details-left\">\n            <p>**Proveedor:** {{ doc.supplier }}</p>\n            <p>RIF: {{ doc.supplier_rif }}</p>\n        </div>\n        <div class=\"details-right\">\n            <p>**Fecha del Comprobante:** {{ doc.posting_date }}</p>\n            <p>**Periodo Impositivo:** {{ doc.start_date }} a {{ doc.end_date }}</p>\n        </div>\n    </div>\n\n    <table>\n        <thead>\n            <tr>\n                <th>Fecha de la Factura</th>\n                <th>Número de Factura</th>\n                <th>Control de Factura</th>\n                <th>Monto de la Factura</th>\n                <th>Base Imponible</th>\n                <th>% Retención</th>\n                <th>Monto Retenido</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.vat_withholding_voucher_item %}\n            <tr>\n                <td>{{ item.posting_date }}</td>\n                <td>{{ item.purchase_invoice }}</td>\n                <td>{{ item.bill_control }}</td>\n                <td>{{ item.grand_total }}</td>\n                <td>{{ item.total }}</td>\n                <td>{{ item.rate }}%</td>\n                <td>{{ item.tax_amount }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"footer\">\n        <p>**Total de Retención:** {{ doc.total_retention }}</p>\n    </div>\n</div>",
