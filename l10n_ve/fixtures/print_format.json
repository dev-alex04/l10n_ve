  "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <style>\r\n        /* Estilos para el formato de impresión */\r\n        @page {\r\n            size: A4 landscape; /* Orientación horizontal */\r\n            margin: 3mm;\r\n        }\r\n\r\n        body {\r\n            font-family: Arial, sans-serif;\r\n            font-size: 9px;\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        .container {\r\n            width: 100%;\r\n            margin: auto;\r\n        }\r\n\r\n        .table-full-width {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        \r\n        .table-no-border {\r\n            border: none;\r\n        }\r\n\r\n        .table-border-all td, .table-border-all th {\r\n            border: 1px solid #000;\r\n        }\r\n\r\n        /* .table-border-all th {\r\n            background-color: #f2f2f2;\r\n        } */\r\n\r\n        .box-title {\r\n            font-size: 10px;\r\n            font-weight: bold;\r\n            padding: 2px 5px;\r\n            text-align: center;\r\n        }\r\n\r\n        .text-center { text-align: center; }\r\n        .text-right { text-align: right; }\r\n        .text-left { text-align: left; }\r\n\r\n        .align-bottom { vertical-align: bottom; }\r\n        .align-top { vertical-align: top; }\r\n\r\n        .header-box {\r\n            border: 1px solid #000;\r\n            padding: 5px;\r\n            display: flex; /* Para controlar el logo y la info de usuario */\r\n            justify-content: space-between;\r\n            align-items: flex-start;\r\n        }\r\n\r\n        .logo-section {\r\n            display: flex;\r\n            align-items: center;\r\n            width: 25%; /* Ajusta el ancho según necesidad */\r\n        }\r\n\r\n        .header-title-section {\r\n            width: 50%; /* Ajusta el ancho según necesidad */\r\n            text-align: center;\r\n            padding-top: 5px; /* Pequeño ajuste para centrar verticalmente si es necesario */\r\n            margin-top: auto;\r\n        }\r\n\r\n        .header-user-info-section {\r\n            width: 25%; /* Ajusta el ancho según necesidad */\r\n            text-align: right;\r\n        }\r\n        \r\n        .main-header {\r\n            font-size: 14px;\r\n            font-weight: bold;\r\n            margin-bottom: 3px;\r\n        }\r\n\r\n        .supplier-company-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-top: 5px;\r\n        }\r\n\r\n        .supplier-company-table th {\r\n            color: #000 !important;\r\n            border: 1px solid #000;\r\n            padding: 3px 5px;\r\n            /* font-size: 10px; */\r\n            font-weight: bold;\r\n            text-align: center;\r\n        }\r\n\r\n        .supplier-company-table td {\r\n            border: 1px solid #000;\r\n            padding: 3px 5px;\r\n            vertical-align: top;\r\n        }\r\n\r\n        .detail-table th, .detail-table td {\r\n            color: #000 !important;\r\n            border: 1px solid #000;\r\n            padding: 5px 2px;\r\n            text-align: center;\r\n        }\r\n\r\n        .info-text-small { font-size: 8px; }\r\n        .info-text-normal { font-size: 9px; }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <div class=\"container\">\r\n        \r\n        <div class=\"header-box\">\r\n            <div class=\"logo-section\">\r\n                <img src=\"https://via.placeholder.com/60x60.png?text=LOGO\" alt=\"Logo\" style=\"width:50px; height:50px; margin-right:5px;\">\r\n                <div style=\"line-height: 1.1;\">\r\n                    <strong>DOMINA ERP</strong><br>\r\n                    {{ doc.empresa }}<br>\r\n                    R.I.F.: {{ frappe.db.get_value(\"Company\", doc.empresa, \"tax_id\") }}\r\n                </div>\r\n            </div>\r\n            <div class=\"header-title-section\">\r\n                <div class=\"main-header\">I.S.L.R. - COMPROBANTE DE RETENCIÓN DE I.S.L.R.</div>\r\n                <div>Fecha:Desde {{ frappe.utils.getdate(doc.start_date).strftime('%d/%m/%Y') }} Hasta {{ frappe.utils.getdate(doc.end_date).strftime('%d/%m/%Y') }}:</div>\r\n            </div>\r\n            <div class=\"header-user-info-section\">\r\n                <table class=\"table-full-width table-no-border info-text-normal\">\r\n                    <tr>\r\n                        <td class=\"text-left\" style=\"width: 40%;\">Usuario:</td>\r\n                        <td class=\"text-left\">YUSBELI</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"text-left\" style=\"width: 40%;\">Página:</td>\r\n                        <td class=\"text-left\">1 de 1</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td class=\"text-left\" style=\"width: 40%;\">Fecha:</td>\r\n                        <td class=\"text-left\">{{ frappe.utils.get_datetime(frappe.utils.now_datetime()).strftime('%d/%m/%Y %I:%M:%S %p') }}</td>\r\n                    </tr>\r\n                </table>\r\n            </div>\r\n        </div>\r\n        \r\n        <table class=\"supplier-company-table\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width: 50%;\">Proveedor / Beneficiario</th>\r\n                    <th style=\"width: 50%;\">Empresa</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                <tr>\r\n                    <td class=\"text-left align-top\">\r\n                        <strong>Proveedor / Beneficiario:</strong> {{ doc.supplier }}<br>\r\n                        <strong>R.I.F.:</strong> {{ frappe.db.get_value(\"Supplier\", doc.supplier, \"tax_id\") }}<br>\r\n                        <strong>N.I.T.:</strong> <br>\r\n                        <strong>Dirección:</strong> {{ doc.supplier_address }}\r\n                    </td>\r\n                    <td class=\"text-left align-top\">\r\n                        <strong>Nombre / Razón Social:</strong> {{ doc.empresa }}<br>\r\n                        <strong>R.I.F.:</strong> {{ frappe.db.get_value(\"Company\", doc.empresa, \"tax_id\") }}<br>\r\n                        <strong>N.I.T.:</strong> <br>\r\n                        <strong>Dirección:</strong> {{ doc.company_address }}\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n        <table class=\"table-full-width detail-table\" style=\"margin-top: 10px;\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width: 6%;\">Fecha</th>\r\n                    <th style=\"width: 9%;\">Número Pago</th>\r\n                    <th style=\"width: 5%;\">Tipo</th>\r\n                    <th style=\"width: 8%;\">N° Doc.</th>\r\n                    <th style=\"width: 8%;\">N° Control</th>\r\n                    <th style=\"width: 12%;\">Monto de Documento</th>\r\n                    <th style=\"width: 12%;\">Monto Abonado</th>\r\n                    <th style=\"width: 15%;\">Monto Objeto a Retención</th>\r\n                    <th style=\"width: 6%;\">Tarifa %</th>\r\n                    <th style=\"width: 8%;\">Código Concepto</th>\r\n                    <th style=\"width: 8%;\">Sustraendo</th>\r\n                    <th style=\"width: 8%;\">Impuesto Retenido</th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {% for item in doc.islr_withholding_voucher_item %}\r\n                    <tr>\r\n                        <td>{{ frappe.utils.getdate(item.posting_date).strftime('%d/%m/%Y') }}</td>\r\n                        <td>0000000008</td>\r\n                        <td>FACT</td>\r\n                        <td>{{ item.bill_no }}</td>\r\n                        <td>{{ item.bill_control }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.grand_total) }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.grand_total) }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.total) }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.rate) }}</td>\r\n                        <td>{{ item.codigo }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.subtracting) }}</td>\r\n                        <td class=\"text-right\">{{ '{:.2f}'.format(item.tax_amount) }}</td>\r\n                    </tr>\r\n                {% endfor %}\r\n                <tr>\r\n                    <td class=\"text-left\">Totales</td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td class=\"text-right\">{{ '{:.2f}'.format(doc.totals_total) }}</td>\r\n                    <td></td>\r\n                    <td></td>\r\n                    <td class=\"text-right\"></td>\r\n                    <td class=\"text-right\">{{ '{:.2f}'.format(doc.totals_tax_amount) }}</td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n</body>\r\n</html>",
